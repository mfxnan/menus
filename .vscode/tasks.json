{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Temporary store name typecheck",
			"type": "shell",
			"command": "node.exe",
			"args": [
				"node_modules/typescript/bin/tsc",
				"-b"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			],
			"group": "build"
		},
		{
			"label": "Temporary store name tests",
			"type": "shell",
			"command": "node.exe",
			"args": [
				"node_modules/vitest/vitest.mjs",
				"run",
				"--reporter=dot"
			],
			"isBackground": false,
			"group": "test"
		}
	]
}